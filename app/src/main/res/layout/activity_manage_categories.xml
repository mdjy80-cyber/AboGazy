<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Spinner android:id="@+id/sp_company" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <EditText android:id="@+id/et_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="@string/hint_name" />
        <EditText android:id="@+id/et_value" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="@string/hint_value" android:inputType="numberDecimal" />
        <EditText android:id="@+id/et_price" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="@string/hint_price" android:inputType="numberDecimal" />
        <Button android:id="@+id/btn_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/btn_add" />
    </LinearLayout>

    <ListView android:id="@+id/lv_categories" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <Button android:id="@+id/btn_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_back" />

</LinearLayout>
